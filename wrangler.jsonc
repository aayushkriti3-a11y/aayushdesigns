{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aayushdesigns",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  },
  // Keep the NDA_PASSWORD set in the dashboard when this file deploys.
  "keep_vars": true
}
